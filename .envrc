# Pixi locked-by-default. See _dev/design/0_active/pixi-lock.md.
#
# `PIXI_LOCKED=1` makes pixi error on manifest/lock drift instead of
# silently regenerating pixi.lock. Lock updates become a deliberate
# verb: `pixi update`. Without this, parallel git worktrees randomly
# rewrite pixi.lock as a side-effect of `pixi run`.
#
# Not a direnv user? Add the same line to your shell init:
#   echo 'export PIXI_LOCKED=1' >> ~/.zshrc
export PIXI_LOCKED=1
